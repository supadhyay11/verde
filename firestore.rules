rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    // users: everyone reads and edits only their own profile. A provider can
    // also read the customers linked to them. providerId and role are only
    // ever set by the linkToProvider / createProfile paths (see below), so a
    // user cannot attach themselves to somebody else's account.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || resource.data.providerId == request.auth.uid);
      // Profile is created once, with no provider link; the callable function
      // linkToProvider sets providerId afterwards.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['provider', 'customer']
        && request.resource.data.language in ['en', 'es']
        && !('providerId' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('providerId', null) == resource.data.get('providerId', null)
        && request.resource.data.get('inviteCode', null) == resource.data.get('inviteCode', null)
        && request.resource.data.language in ['en', 'es'];
    }

    // providerProfiles: the part of a provider's profile their linked
    // customers may see (name, Zelle and Venmo handles). The provider writes it.
    match /providerProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || me().get('providerId', null) == uid);
      allow write: if signedIn() && request.auth.uid == uid && me().role == 'provider';
    }

    // invoices: anyone holding the exact (unguessable) id can open one, signed
    // in or not, which is what makes the shared link work. Lists are limited to
    // the gardener who made them and the customer they are for.
    match /invoices/{invoiceId} {
      allow get: if true;
      allow list: if signedIn() && (resource.data.providerId == request.auth.uid
        || resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && me().role == 'provider'
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == 'unpaid'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000;
      allow update: if signedIn() && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.number == resource.data.number
        && request.resource.data.amount == resource.data.amount;
      allow delete: if signedIn() && resource.data.providerId == request.auth.uid;
    }

    // support messages: anyone signed in can leave one (as themselves); only
    // the Verde team reads them, in the Firebase console.
    match /supportRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }

    // customers the gardener added by hand. Only that gardener can see or
    // change them; claiming one (when the customer enters its code) is done
    // by the linkToProvider Cloud Function, never from the app.
    match /providerCustomers/{id} {
      allow read, delete: if signedIn() && resource.data.providerId == request.auth.uid;
      allow create: if signedIn() && me().role == 'provider'
        && request.resource.data.providerId == request.auth.uid
        && !('claimedBy' in request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update: if signedIn() && resource.data.providerId == request.auth.uid
        && !('claimedBy' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'language'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
    }

    // jobs: the provider who owns it and the customer it is for can read it.
    // Only the provider writes. Translations are written by Cloud Functions.
    match /jobs/{jobId} {
      // Once the report is sent, anyone holding the exact (unguessable) job id
      // can open it: that is the shared report link. Lists stay private.
      allow get: if (signedIn() && (resource.data.providerId == request.auth.uid
        || resource.data.customerId == request.auth.uid))
        || resource.data.get('reportSentAt', null) != null;
      allow list: if signedIn() && (resource.data.providerId == request.auth.uid
        || resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.providerId == request.auth.uid
        && me().role == 'provider'
        && !('descriptionTranslations' in request.resource.data)
        && !('noteTranslations' in request.resource.data);
      allow update: if signedIn() && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.get('descriptionTranslations', null) == resource.data.get('descriptionTranslations', null)
        && request.resource.data.get('noteTranslations', null) == resource.data.get('noteTranslations', null);
      allow delete: if signedIn() && resource.data.providerId == request.auth.uid;
    }

    // chat: thread id is "<providerId>_<customerId>"; only those two people
    // can read or write. The translations field is written only by a Cloud
    // Function, never by a client.
    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in threadId.split('_');
      allow create, update: if signedIn() && request.auth.uid in threadId.split('_')
        && request.resource.data.keys().hasOnly(['providerId', 'customerId', 'lastText', 'lastAt', 'lastSenderId'])
        && threadId == request.resource.data.providerId + '_' + request.resource.data.customerId;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in threadId.split('_');
        allow create: if signedIn() && request.auth.uid in threadId.split('_')
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.lang in ['en', 'es']
          && !('translations' in request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
