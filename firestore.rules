rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myBusinessId() {
      return userDoc().data.businessId;
    }

    function myRole() {
      return userDoc().data.role;
    }

    function myPropertyId() {
      return userDoc().data.propertyId;
    }

    // "provider" role accounts split into "admin" (manages customers,
    // billing, team, business profile) and "technician" (completes
    // assigned jobs only) - see BusinessRole in src/types/index.ts.
    // .get(key, default) treats every pre-existing single-operator
    // account (no businessRole field at all) as "admin", so nothing about
    // an existing business's access changes just because this field now
    // exists.
    function myBusinessRole() {
      return userDoc().data.get('businessRole', 'admin');
    }

    function isBizAdmin() {
      return isSignedIn() && myRole() == 'provider' && myBusinessRole() == 'admin';
    }

    function sameBusiness(resourceData) {
      return isSignedIn() && resourceData.businessId == myBusinessId();
    }

    // Platform-support role, provisioned by hand directly in Firebase (see
    // docs/admin-access.md) - never selectable on the public sign-up form,
    // so the only way to become an admin is for the app owner to create
    // the account themselves. Gives read access across every business for
    // support/debugging, plus the ability to manage (edit/delete) any
    // customer record. It intentionally does NOT grant write access to
    // jobs, messages, or businesses - an admin can look into a problem and
    // fix a customer record, but can't rewrite service history or business
    // billing details.
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    // Users can read their own profile and any teammate in the same
    // business (needed to show the service provider's name, chat
    // counterparts, etc), or any user at all if they're an admin. A user
    // can only be created/updated by themselves; role/businessId changes
    // should go through a trusted server context (Cloud Function) in a
    // later hardening pass.
    match /users/{userId} {
      // A customer (owner) can see their own profile and their provider's
      // staff (needed for chat names), but NOT other customers' profiles -
      // those hold name/email/phone. Providers can still see everyone in
      // their business. Owner-side queries must therefore filter on
      // role == "provider" (see firebase-jobs-store.tsx).
      allow read: if isSignedIn() &&
        (request.auth.uid == userId ||
         (resource.data.businessId == myBusinessId() &&
          (myRole() == 'provider' || resource.data.role == 'provider')) ||
         isAdmin());
      // SECURITY: self-created profiles may ONLY be a brand-new business's
      // first admin. Previously any signed-in user could create their own
      // users/{uid} with role "admin" (platform support - read/delete
      // everything, impersonate any provider) or with any other business's
      // businessId. Now: role must be "provider"/"admin", and the business
      // must be one this same user just created (ownerUid == their uid).
      // getAfter() so it also works if the business + profile are ever
      // written in one batch. Owner (customer) profiles are created only by
      // the claimInvite Cloud Function (Admin SDK) and platform-admin
      // accounts only by hand in the console - neither goes through here.
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'provider' &&
        request.resource.data.get('businessRole', 'admin') == 'admin' &&
        !('propertyId' in request.resource.data) &&
        getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.get('ownerUid', null) == request.auth.uid;
      // Self-update covers everyday profile edits (name, phone, chat
      // read-markers) but must never let a technician promote themselves
      // to admin, move themselves to a different business, or change
      // their own role - those only ever happen server-side, via the
      // createTechnician/updateTeamMemberRole Cloud Functions (Admin SDK,
      // bypasses these rules), which check the CALLER's own admin status
      // before touching anyone. See functions/team.js.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.get('businessRole', 'admin') == resource.data.get('businessRole', 'admin') &&
        // propertyId decides which customer's jobs/messages/invoices an
        // owner can read - it must never be self-editable (otherwise any
        // customer could point themselves at someone else's property).
        request.resource.data.get('propertyId', null) == resource.data.get('propertyId', null);
      // Admin-only, and only as part of removing an entire business (its
      // provider/owner accounts stop having anywhere to sign into once the
      // business is gone). Never available to a business's own members.
      allow delete: if isAdmin();

      // One doc per device that's turned on push notifications, keyed by
      // that device's FCM token. Only the account owner can register or
      // remove their own tokens - Cloud Functions read/write these with
      // the Admin SDK when actually sending a push, which bypasses these
      // rules entirely.
      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn() && (businessId == myBusinessId() || isAdmin());
      // Created client-side during provider (business) sign-up; tighten
      // to a Cloud Function once one exists to mint businesses server-side.
      // Created client-side during provider sign-up. ownerUid must be the
      // creator - the users/{uid} create rule above relies on it to stop
      // someone from attaching themselves to a business they don't own.
      allow create: if isSignedIn() &&
        request.resource.data.get('ownerUid', null) == request.auth.uid;
      // A provider can edit their own business's profile - this is what
      // lets them set up Payment Settings (Venmo/Zelle) from their
      // profile page. Still nobody else's business, and still not an
      // owner or admin (admin write access to business billing details
      // is deliberately withheld, per the note above).
      //
      // The four stripe* fields are excluded from what a plain client
      // write can change - they're status mirrors of the business's
      // real Stripe Connect account, written only by Cloud Functions
      // (createStripeConnectAccount / stripeConnectWebhook) using the
      // Admin SDK, which bypasses these rules entirely. Without this, a
      // business admin could set stripeChargesEnabled=true from the
      // browser console without ever actually finishing Stripe
      // onboarding - harmless to real money (a fake connected account
      // id still can't move money server-side), but it would corrupt
      // the UI's "are we actually ready to accept payments" state.
      allow update: if isSignedIn() &&
        businessId == myBusinessId() && isBizAdmin() &&
        request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null) &&
        request.resource.data.get('stripeAccountId', null) == resource.data.get('stripeAccountId', null) &&
        request.resource.data.get('stripeChargesEnabled', false) == resource.data.get('stripeChargesEnabled', false) &&
        request.resource.data.get('stripePayoutsEnabled', false) == resource.data.get('stripePayoutsEnabled', false) &&
        request.resource.data.get('stripeDetailsSubmitted', false) == resource.data.get('stripeDetailsSubmitted', false);
      // Admin-only "remove this business" action from the support console.
      allow delete: if isAdmin();
    }

    // A property represents one customer. It starts unclaimed (ownerId ==
    // null) when the provider adds the customer, and gets claimed once the
    // customer signs up with their invite code. Owners may only ever read
    // or touch their own property, never a business-mate's. An admin can
    // read, edit, or remove any customer across any business.
    match /properties/{propertyId} {
      allow read: if isSignedIn() &&
        ((myRole() == 'provider' && resource.data.businessId == myBusinessId()) ||
         (myRole() == 'owner' && resource.data.ownerId == request.auth.uid) ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.businessId == myBusinessId() &&
        isBizAdmin() &&
        request.resource.data.ownerId == null;
      // Owners no longer claim their property via a direct client write -
      // that now happens inside the claimInvite Cloud Function (Admin SDK,
      // bypasses these rules entirely) as one atomic transaction, which is
      // also what fixed the intermittent "insufficient permissions" error
      // customers hit signing up. So the only client-side writers left here
      // are the provider (their own business's properties) and admin.
      // A business admin can't re-home a customer to another business or
      // hand it to a different owner account - businessId and ownerId are
      // fixed by the claimInvite function / creation (platform admin exempt).
      allow update: if isSignedIn() &&
        (isAdmin() ||
         (resource.data.businessId == myBusinessId() && isBizAdmin() &&
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)));
      allow delete: if isSignedIn() &&
        (isAdmin() ||
         (resource.data.businessId == myBusinessId() && isBizAdmin()));
    }

    // One-time invite codes minted by a provider when they add a customer.
    // SECURITY: no client can read these any more. They used to be readable
    // (including list) by every signed-in user, which let anyone enumerate
    // every unused invite code and claim another business's customer. The
    // claimInvite Cloud Function validates codes server-side (Admin SDK), so
    // the browser never needs to read this collection.
    match /inviteCodes/{code} {
      allow read: if false;
      allow create: if isSignedIn() &&
        isBizAdmin() &&
        request.resource.data.businessId == myBusinessId();
      // Marking a code used now happens only inside the claimInvite Cloud
      // Function (Admin SDK, bypasses these rules) as part of its atomic
      // claim transaction, so no client write path needs to be open here.
      allow update: if false;
      allow delete: if false;
    }

    match /jobs/{jobId} {
      // Signed-in read: provider sees every job in their business, an
      // owner only their own property's jobs.
      //
      // Public read (get only - never list): the emailed/texted report
      // link opens a specific job by its (unguessable) auto-generated ID,
      // with no login. Only completed jobs are exposed this way, and only
      // the reportXxx snapshot fields + service details are shown - the
      // page never reads the property/business docs, so nothing like a
      // gate code is ever reachable through this path. `list` is never
      // granted here, so this can't be used to browse a business's jobs.
      allow get: if
        (isSignedIn() &&
         ((myRole() == 'provider' && resource.data.businessId == myBusinessId()) ||
          (myRole() == 'owner' && resource.data.propertyId == myPropertyId()) ||
          isAdmin())) ||
        resource.data.status == 'completed';
      allow list: if isSignedIn() &&
        ((myRole() == 'provider' && resource.data.businessId == myBusinessId()) ||
         (myRole() == 'owner' && resource.data.propertyId == myPropertyId()) ||
         isAdmin());
      // Scheduling a new visit is meant to be an admin-only action in the
      // UI (the "Schedule Service" route is admin-gated) - but this rule
      // itself stays open to any business member, admin or technician,
      // because completing a RECURRING job auto-creates its next
      // occurrence as a plain client-side write (see updateJob in
      // firebase-jobs-store.tsx), and that has to keep working no matter
      // who - admin or technician - is the one marking the job done.
      allow create: if isSignedIn() &&
        request.resource.data.businessId == myBusinessId() && myRole() == 'provider';
      // Both an admin and a technician can edit a job (fill in the
      // report, mark it complete) - admin still can't rewrite service
      // history, per docs/admin-access.md. Admin CAN delete a job, needed
      // only to clean up jobs when removing a business entirely.
      // businessId can't be changed (otherwise a job could be pushed into
      // another business's customer feed).
      allow update: if sameBusiness(resource.data) && myRole() == 'provider' &&
        request.resource.data.businessId == resource.data.businessId;
      allow delete: if isAdmin() || (sameBusiness(resource.data) && isBizAdmin());
    }

    // An invoice the provider sends to one customer. Same public-link
    // pattern as jobs: the emailed/texted invoice link opens a specific
    // invoice by its unguessable auto-generated ID with no login, so the
    // customer can view amount/period and pay via the snapshotted
    // Venmo/Zelle info without ever reading the property or business docs
    // directly. `list` is never granted publicly, so this can't be used to
    // browse a business's invoices - only to open one you already have the
    // link to. Only the provider can mark it paid/unpaid (there's no real
    // payment processor here, so this is always a manual, honor-system
    // status flip - see docs/architecture notes on the Invoice feature).
    match /invoices/{invoiceId} {
      // Any invoice can be fetched by its exact (unguessable) ID, signed in
      // or not - that's what lets the emailed/texted invoice link work
      // without requiring the customer to log in.
      allow get: if true;
      allow list: if isSignedIn() &&
        ((myRole() == 'provider' && resource.data.businessId == myBusinessId()) ||
         (myRole() == 'owner' && resource.data.propertyId == myPropertyId()) ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.businessId == myBusinessId() && isBizAdmin();
      allow update: if sameBusiness(resource.data) && isBizAdmin();
      allow delete: if isAdmin() || (sameBusiness(resource.data) && isBizAdmin());
    }

    // One persistent conversation per customer relationship (keyed by
    // propertyId), not per job - owners only ever see their own thread.
    match /messages/{messageId} {
      allow read: if isSignedIn() &&
        ((myRole() == 'provider' && resource.data.businessId == myBusinessId()) ||
         (myRole() == 'owner' && resource.data.propertyId == myPropertyId()) ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.businessId == myBusinessId() &&
        request.resource.data.senderId == request.auth.uid &&
        (myRole() == 'provider' || request.resource.data.propertyId == myPropertyId());
      allow update: if false;
      // Admin-only, and only to clean up messages when removing a business.
      allow delete: if isAdmin();
    }
  }
}
