rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Job photos live at jobs/<providerId>/<jobId>/<file>. Only that provider
    // can upload (images up to 10 MB). Signed-in users can read; the file
    // links are long random tokens and are only shown to the job's customer.
    match /jobs/{providerId}/{jobId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == providerId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == providerId;
    }
  }
}
